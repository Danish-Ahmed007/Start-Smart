# Example environment variables for StartSmart development
# Copy this to `.env` and update values as needed.

# Primary database URL used by scripts and services (psycopg2/SQLAlchemy URI)
# Example: postgresql://postgres:postgres@localhost:5432/startsmart_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/startsmart_dev

# Convenience individual Postgres vars (used by docker-compose and tests)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=startsmart_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional - reproducible seed for generators
DEFAULT_RANDOM_SEED=42
